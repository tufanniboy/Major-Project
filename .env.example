# Copy to .env, or run npm run setup. Do not share your real .env file.
# Default: a local lab without a model or persistent database.
PORT=8000
SOC_HOSTED=false
DATABASE_URL=

# Authenticated token used by the Windows Security log collector. Keep private.
SENSOR_INGEST_TOKEN=
SENSOR_URL=

# Real model: leave blank for simulation only; use auto for fallback.
# Single-provider mode also accepts gemini, openai or ollama with LLM_MODEL.
LLM_PROVIDER=
LLM_MODEL=
LLM_PROVIDERS=gemini,openai,ollama
LLM_TIMEOUT_MS=30000
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-4.1-mini
# Set after installing the local model, e.g. llama3.2:3b.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hosted deployment only. Use your own values in the hosting dashboard.
SOC_ADMIN_PASSWORD=
LAB_JOIN_CODE=
PUBLIC_URL=
